{
  "name": "@drenner/ai-agent-configs",
  "private": true,
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "format": "prettier . --write",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "3.10.1"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "proseWrap": "never"
        }
      }
    ]
  }
}
